# Port to run the proxy server on
PORT=3000

# Host to bind (0.0.0.0 allows external / container connections)
HOST=0.0.0.0

# NVIDIA NIM API Base URL (Default: https://integrate.api.nvidia.com/v1)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA API Key (Optional fallback if not sent in client request's Authorization header)
NVIDIA_API_KEY=nvapi-your-key-here

# Default model if none specified in request
DEFAULT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Request logging (true / false)
LOG_REQUESTS=true

# Upstream Timeout in milliseconds (default: 180000 = 3 minutes)
TIMEOUT_MS=180000
